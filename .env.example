# ---------------------------------------------------------------------------
# Abdedaym Chakra — Portfolio
# ---------------------------------------------------------------------------
# This portfolio runs with ZERO environment variables.
# Every variable below is OPTIONAL and only improves SEO metadata.
#
# To use one locally: copy this file to `.env.local` and fill in the value.
#   cp .env.example .env.local
#
# NEVER commit `.env.local` — it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# The public canonical URL of the deployed site.
# Used for: canonical <link>, Open Graph URLs, sitemap.xml and robots.txt.
# If left empty, the site falls back to the VERCEL_URL that Vercel injects
# automatically, and then to http://localhost:3000 during local development.
# Example: https://abdedaym-chakra.vercel.app
NEXT_PUBLIC_SITE_URL=
